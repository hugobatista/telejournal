TELEGRAM_TOKEN=your_bot_token
LOG_LEVEL=INFO
TELEGRAM_ALLOWED_USER_IDS=123456789
STORAGE_PROVIDER=obsidian_vault
STORAGE_OBSIDIAN_VAULT_ROOT=/path/to/obsidian/vault

# Optional settings
# MESSAGE_TIMESTAMP_WINDOW_SECONDS=60

# Security: Set restrictive file permissions (0o700/0o600) on vault directories and files
# Enabled by default for security. Set to "false" to disable if needed.
# STORAGE_OBSIDIAN_VAULT_SECURE_FILE_PERMISSIONS=true

# GitHub provider (alternative to filesystem vault)
# STORAGE_PROVIDER=github_repo
# STORAGE_GITHUB_OWNER=your-github-owner
# STORAGE_GITHUB_REPO=your-journal-repo
# STORAGE_GITHUB_BRANCH=main
# Use a fine-grained PAT scoped to one repository with Contents read/write.
# STORAGE_GITHUB_TOKEN=github_pat_xxx
# STORAGE_GITHUB_PATH_PREFIX=
# STORAGE_GITHUB_API_BASE_URL=https://api.github.com
# STORAGE_GITHUB_BATCH_WINDOW_SECONDS=60
